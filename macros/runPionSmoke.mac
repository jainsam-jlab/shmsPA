# Initialize geometry and physics
/run/initialize

# Do not use the external focal-plane event file
/PA/generator/useGenerated false

# Disable pion decay because this workflow assumes SIMC handles decay
/process/inactivate Decay pi+
/run/physicsModified

# Incident particle and momentum
/gun/particle pi+
/PA/generator/momentum 5 GeV

# ROOT output
/analysis/setFileName out/pion_smoke_5GeV.root

# Print progress and run 100 events
/run/printProgress 10
/run/beamOn 100